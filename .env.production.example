APP_NAME="Barbearia Oliveira Alves"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
SERVER_NAME=barbearia-oliveira-alves.matheushrm.dev
BARBEARIA_TZ=America/Sao_Paulo
BARBEARIA_NAME="Barbearia Oliveira Alves"
BARBEARIA_ADDRESS="Av. Márcia Antônia, 1052 · Tupanuara · São Joaquim de Bicas/MG"
APP_URL=https://barbearia-oliveira-alves.matheushrm.dev

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=barbearia.postgres.database.azure.com
DB_PORT=5432
DB_DATABASE=barbearia
DB_USERNAME=barbeariaadmin
DB_PASSWORD=<senha-do-postgresql>
DB_SSLMODE=require

# Usado somente pelo PostgreSQL local da VM.
POSTGRES_DB=barbearia
POSTGRES_USER=barbeariaadmin
POSTGRES_PASSWORD=<senha-do-postgresql-local>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@barbeariaoliveiraalves.com.br"
MAIL_FROM_NAME="${APP_NAME}"

BARBEARIA_RESERVATION_TTL_MIN=10
BARBEARIA_CANCEL_WINDOW_HOURS=12
BARBEARIA_MIN_LEAD_MIN=60
BARBEARIA_HORIZON_DAYS=21
BARBEARIA_SLOT_STEP_MIN=15
BARBEARIA_CHURN_DAYS=60
